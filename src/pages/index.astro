---
import Layout from '@/layouts/Layout.astro';
import Links from '@/components/links.tsx';
import Blog from '@/components/sections/blog.tsx';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Wasimul Sami">
  <main class="font-base">
    <section>
      <h1 class="text-2xl font-heading sm:text-4xl">Wasimul Sami</h1>
      <div class="mt-4 text-base">
        <p>
          I'm Sami, currently running <a href="https://www.levelaxishq.com" class="underline" target="_blank" rel="noopener noreferrer">Levelaxis</a>. I love thinking about game theory, emergence complexity, mimetic desire.
        </p>
      </div>
    </section>

    <div class="mt-8">
      <Links client:load />
    </div>

    <div class="mt-8">
      <Blog client:load posts={posts} />
    </div>
  </main>
</Layout>
